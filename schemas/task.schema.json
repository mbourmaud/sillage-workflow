{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mbourmaud/sillage-workflow/schemas/task.schema.json",
  "title": "Sillage task",
  "type": "object",
  "required": ["id", "title", "status", "intent", "acceptance", "slices"],
  "properties": {
    "id": { "$ref": "#/$defs/non_blank" },
    "title": { "$ref": "#/$defs/non_blank" },
    "status": { "enum": ["INTAKE", "INVESTIGATE", "DECIDE", "IMPLEMENT", "VERIFY", "REVIEW", "HANDOFF", "BLOCKED"] },
    "intent": {
      "type": "object",
      "required": ["outcome", "scope", "non_goals"],
      "properties": {
        "outcome": { "$ref": "#/$defs/non_blank" },
        "scope": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/non_blank" } },
        "non_goals": { "type": "array", "items": { "$ref": "#/$defs/non_blank" } }
      },
      "additionalProperties": false
    },
    "classification": { "enum": ["probe", "bounded", "cross-cutting"] },
    "primary_lens": { "$ref": "#/$defs/lens" },
    "secondary_lenses": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/lens" }
    },
    "risk_owners": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/non_blank" }
    },
    "execution": { "$ref": "#/$defs/execution_plan" },
    "delegation": { "$ref": "#/$defs/delegation_plan" },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    },
    "approval": {
      "type": "object",
      "required": ["by", "at", "decision_digest"],
      "properties": {
        "by": { "type": "string", "pattern": "^human:.*\\S.*$" },
        "at": { "type": "string", "format": "date-time" },
        "decision_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "blocked": {
      "type": "object",
      "required": ["from", "resume_condition"],
      "properties": {
        "from": { "enum": ["INTAKE", "INVESTIGATE", "DECIDE", "IMPLEMENT", "VERIFY", "REVIEW", "HANDOFF"] },
        "resume_condition": { "$ref": "#/$defs/non_blank" }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "risk"],
        "properties": {
          "id": { "$ref": "#/$defs/non_blank" },
          "statement": { "$ref": "#/$defs/non_blank" },
          "risk": { "$ref": "#/$defs/non_blank" },
          "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
          "waiver": { "$ref": "#/$defs/waiver" }
        },
        "additionalProperties": false
      }
    },
    "slices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "acceptance", "dependencies"],
        "properties": {
          "id": { "$ref": "#/$defs/non_blank" },
          "title": { "$ref": "#/$defs/non_blank" },
          "status": { "enum": ["planned", "active", "complete", "blocked"] },
          "acceptance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/non_blank" } },
          "dependencies": { "type": "array", "items": { "$ref": "#/$defs/non_blank" } }
        },
        "additionalProperties": false
      }
    },
    "review": { "$ref": "#/$defs/review" },
    "handoff": { "$ref": "#/$defs/handoff" }
  },
  "$defs": {
    "non_blank": { "type": "string", "pattern": "\\S" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "lens": {
      "enum": [
        "none", "architecture", "testing", "ddd", "solid", "interface",
        "systems", "security", "platform", "frontend-architecture",
        "relational-data", "document-data", "audit", "migrate", "debug",
        "test-hygiene"
      ]
    },
    "execution_plan": {
      "type": "object",
      "required": ["default"],
      "properties": {
        "default": { "$ref": "#/$defs/execution_profile" },
        "overrides": {
          "type": "object",
          "properties": {
            "INTAKE": { "$ref": "#/$defs/execution_profile" },
            "INVESTIGATE": { "$ref": "#/$defs/execution_profile" },
            "DECIDE": { "$ref": "#/$defs/execution_profile" },
            "IMPLEMENT": { "$ref": "#/$defs/execution_profile" },
            "VERIFY": { "$ref": "#/$defs/execution_profile" },
            "REVIEW": { "$ref": "#/$defs/execution_profile" },
            "HANDOFF": { "$ref": "#/$defs/execution_profile" },
            "BLOCKED": { "$ref": "#/$defs/execution_profile" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "execution_profile": {
      "type": "object",
      "required": ["capability", "effort"],
      "properties": {
        "capability": { "enum": ["light", "standard", "advanced", "frontier"] },
        "effort": { "enum": ["low", "medium", "high", "max"] }
      },
      "additionalProperties": false
    },
    "delegation_plan": {
      "type": "object",
      "required": ["default"],
      "properties": {
        "default": { "$ref": "#/$defs/delegation_request" },
        "overrides": {
          "type": "object",
          "properties": {
            "INTAKE": { "$ref": "#/$defs/delegation_request" },
            "INVESTIGATE": { "$ref": "#/$defs/delegation_request" },
            "DECIDE": { "$ref": "#/$defs/delegation_request" },
            "IMPLEMENT": { "$ref": "#/$defs/delegation_request" },
            "VERIFY": { "$ref": "#/$defs/delegation_request" },
            "REVIEW": { "$ref": "#/$defs/delegation_request" },
            "HANDOFF": { "$ref": "#/$defs/delegation_request" },
            "BLOCKED": { "$ref": "#/$defs/delegation_request" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "delegation_request": {
      "type": "object",
      "required": ["mode", "role", "isolation", "return"],
      "properties": {
        "mode": { "enum": ["parent", "subagent"] },
        "role": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "isolation": { "enum": ["same_context", "read_only", "isolated_worktree"] },
        "return": { "enum": ["summary", "decision_packet", "implementation_patch", "verification_evidence", "review_findings", "handoff_packet"] },
        "required": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "parent" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "isolation": { "const": "same_context" },
              "required": { "const": false }
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "subagent" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "isolation": { "enum": ["read_only", "isolated_worktree"] }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "ref", "observed_at", "result", "decision_digest"],
      "properties": {
        "kind": { "$ref": "#/$defs/non_blank" },
        "ref": { "$ref": "#/$defs/non_blank" },
        "observed_at": { "type": "string", "format": "date-time" },
        "result": { "enum": ["passed", "observed"] },
        "decision_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "waiver": {
      "type": "object",
      "required": ["by", "at", "reason", "impact", "decision_digest"],
      "properties": {
        "by": { "type": "string", "pattern": "^human:.*\\S.*$" },
        "at": { "type": "string", "format": "date-time" },
        "reason": { "$ref": "#/$defs/non_blank" },
        "impact": { "$ref": "#/$defs/non_blank" },
        "decision_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["id", "question", "answer", "status", "by", "at"],
      "properties": {
        "id": { "$ref": "#/$defs/non_blank" },
        "question": { "$ref": "#/$defs/non_blank" },
        "answer": { "$ref": "#/$defs/non_blank" },
        "status": { "enum": ["accepted", "rejected"] },
        "by": { "type": "string", "pattern": "^human:.*\\S.*$" },
        "at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["status", "by", "at", "summary", "decision_digest"],
      "properties": {
        "status": { "enum": ["accepted", "changes_requested"] },
        "by": { "type": "string", "pattern": "^(reviewer:|human:).*\\S.*$" },
        "at": { "type": "string", "format": "date-time" },
        "summary": { "$ref": "#/$defs/non_blank" },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/review_finding" }
        },
        "decision_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "review_finding": {
      "type": "object",
      "required": ["severity", "ref", "detail"],
      "properties": {
        "severity": { "enum": ["blocking", "non_blocking"] },
        "ref": { "$ref": "#/$defs/non_blank" },
        "detail": { "$ref": "#/$defs/non_blank" }
      },
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "required": ["outcome", "next_action", "at", "decision_digest"],
      "properties": {
        "outcome": { "$ref": "#/$defs/non_blank" },
        "next_action": { "$ref": "#/$defs/non_blank" },
        "at": { "type": "string", "format": "date-time" },
        "decision_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "BLOCKED" } }, "required": ["status"] },
      "then": { "required": ["blocked"] }
    }
  ],
  "additionalProperties": false
}
